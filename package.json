{
  "name": "douyin-vue",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host --open",
    "start": "vite --host",
    "serve": "vite --host",
    "build": "vite build",
    "test-del-json": "node node/remove-dist-json.js",
    "build-uni-app": "vite build --mode uni",
    "build-gp-pages": "vite build --mode gp_pages",
    "build-gitee-pages": "vite build --mode gitee_pages && pnpm run test-del-json",
    "build-only": "vite build",
    "build-check": "run-p type-check \"build-only {@}\" --",
    "type-check": "vue-tsc --build --force",
    "report": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "prepare": "husky",
    "commit": "git-cz"
  },
  "dependencies": {
    "@jambonn/vue-lazyload": "1.0.9",
    "axios": "^1.15.0",
    "axios-mock-adapter": "^1.22.0",
    "core-js": "3.21.1",
    "libarchive-wasm": "^1.1.0",
    "mockjs": "^1.1.0",
    "pinia": "^2.1.7",
    "vue": "^3.5.13",
    "vue-router": "4.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.2.1",
    "@commitlint/config-conventional": "^19.1.0",
    "@eslint/js": "^10.0.1",
    "@iconify/vue": "^4.1.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tsconfig/node20": "^20.1.2",
    "@types/node": "^20.11.28",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@vue/tsconfig": "^0.5.1",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "git-last-commit": "^1.0.1",
    "globals": "^17.13.0",
    "husky": "^9.0.11",
    "less": "4.1.3",
    "lint-staged": "^15.2.2",
    "rollup-plugin-visualizer": "^5.9.2",
    "typescript": "^6.0.3",
    "unplugin-vue-macros": "^2.9.1",
    "vite": "^6.4.2",
    "vite-plugin-cdn-import": "0.3.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.1.6"
  },
  "lint-staged": {
    "*.{js,ts,vue,jsx,tsx}": [
      "eslint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}